{
  "compilerOptions": {
    /* Vite transpiles per-file with esbuild and never runs tsc, so this config
       is purely a type checker (`npm run typecheck`). */
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* vite/client declares the image, video and ?raw/?url module types;
       vitest/globals covers describe/it/expect without importing them. */
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src", "vite.config.ts", "eslint.config.js"]
}
